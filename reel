#!/bin/bash
# One command, whole process: paste a Zillow link, get a video.
#
#   ./reel                          asks for the link
#   ./reel <zillow-url>             scrape -> review -> photos -> video -> Drive
#   ./reel <saved-page.html>        read a page you saved yourself, no request
#
# After scraping it prints what it found and waits: press Enter to accept and
# build, or type a field number to correct something first.
#
# If Zillow asks for the human check, this opens a browser, waits for you to
# clear it, and carries straight on — no second command, no flags to remember.
# The cookie is saved, so it usually only ever asks once.
#
# Anything extra is passed through:  ./reel <url> --max-photos 8 --no-drive
# Other modes:                       ./reel batch listings.csv
#                                    ./reel --manual listing.json

set -uo pipefail

# Resolve the project from the script's own location but stay in the caller's
# directory, so relative paths they type (listing.json, --out ./videos) land
# where they expect rather than inside the repo.
HERE="$(cd "$(dirname "$0")" && pwd)"
PY="$HERE/.venv/bin/python"
PROFILE="${ZILLOW_PROFILE:-$HOME/.zillow-profile}"

if [ ! -x "$PY" ]; then
    echo "First-time setup (once):"
    echo "    cd $HERE && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
    exit 1
fi

# Skip the Drive step automatically until OAuth credentials exist, so a first
# run produces a video instead of a wall of setup instructions.
# Expanded with the ${ARR[@]+...} guard below: on bash 3.2 an empty array and
# `set -u` are an error, and this array is empty whenever Drive is configured.
DRIVE=()
if [ ! -f "$HOME/.config/zillow-reels/client_secret.json" ] \
   && [ ! -f "client_secret.json" ] && [ ! -f "$HERE/client_secret.json" ]; then
    DRIVE=(--no-drive)
fi

# Subcommands that never fetch a page get no browser flags.
case "${1:-}" in
    batch|template|auth|probe)
        SUB="$1"; shift
        exec "$PY" -m zillow_reels "$SUB" "$@"
        ;;
    --manual)
        # Review applies here too: it is skipped when stdin isn't a terminal,
        # and it is the last chance to catch a typo in a hand-filled template.
        exec "$PY" -m zillow_reels make "$@" --review ${DRIVE[@]+"${DRIVE[@]}"}
        ;;
    -h|--help)
        sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

# No URL given: just ask for one.
if [ $# -eq 0 ]; then
    printf 'Paste the Zillow listing link: '
    read -r URL
    [ -z "$URL" ] && { echo "No link given."; exit 1; }
    set -- "$URL"
fi

# A saved page instead of a link. When Zillow's human check refuses to pass
# even for a real person — it can reject the gesture purely because the
# browser was started by automation — open the listing in your own browser,
# scroll to the bottom so everything loads, File > Save Page As, and hand the
# .html here. No request is made to Zillow at all.
if [ -f "$1" ]; then
    echo "  Reading the saved page (no request to Zillow)."
    exec "$PY" -m zillow_reels make --from-html "$1" "${@:2}" --review ${DRIVE[@]+"${DRIVE[@]}"}
fi

BROWSER=(--fetch browser --browser-channel chrome --browser-profile "$PROFILE" --review)

# First attempt stays quiet about the fallback template: if it fails we retry
# below, and a template written now would just be confusing litter.
"$PY" -m zillow_reels make "$@" ${BROWSER[@]+"${BROWSER[@]}"} ${DRIVE[@]+"${DRIVE[@]}"} --no-fallback-template
STATUS=$?

# Exit 3 means it could not get the data — nearly always the human check.
# Reopen with a visible browser and let the operator clear it, then continue.
if [ $STATUS -eq 3 ]; then
    echo
    echo "──────────────────────────────────────────────────────────────"
    echo " Zillow wants to confirm you're human."
    echo " A browser window is opening — press & hold the button in it."
    echo " Everything continues automatically once you do."
    echo "──────────────────────────────────────────────────────────────"
    echo
    "$PY" -m zillow_reels make "$@" ${BROWSER[@]+"${BROWSER[@]}"} ${DRIVE[@]+"${DRIVE[@]}"} \
        --show-browser --solve-challenge
    STATUS=$?
fi

exit $STATUS
